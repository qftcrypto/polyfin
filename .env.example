# =============================================================================
# polyfin - environment / secrets
#
# Copy to `.env` and replace the placeholders.  `.env` is gitignored; NEVER
# commit real keys.
#
# CREDENTIALS ONLY.  Every behaviour knob (sizing, edge threshold, risk limits)
# lives in polyfin/live/config.py, which is git-tracked.  Going live is the
# `--live` flag plus the control row, never an env var.
#
# Variables are FIN_-prefixed so this wallet can never be confused with a
# sibling bot's (polycrypto uses CRYPTO_*).  Separate deposit wallets, always.
#
# A paper run needs only the database block.
# =============================================================================

# -- Database (recorder, model, paper and live trader) ------------------------
# `docker compose up -d`, then `python -m polyfin.db` creates the schema.
# Port 5446: polycrypto is 5444, 5445 is canadapulse on the laptop.
FIN_PGHOST=127.0.0.1
FIN_PGPORT=5446
FIN_PGUSER=polyfin
FIN_PGDATABASE=polyfin
FIN_PGPASSWORD=CHANGE_ME_STRONG_PASSWORD

# -- Live trading only (not needed for paper) ---------------------------------
# The EOA private key.  It signs orders; it does not hold the collateral.
FIN_PRIVATE_KEY=0xCHANGE_ME

# The sig_type=3 (POLY_1271) deposit-wallet proxy owned by that EOA - the funder
# that holds pUSD and is the maker of every order.  Supply it explicitly; do not
# re-derive (the factory implementation changed 2026-06-29).
FIN_DEPOSIT_WALLET=0xCHANGE_ME
FIN_SIGNATURE_TYPE=3

# CLOB L2 API credentials, derived once from the EOA (scripts to follow).
FIN_API_KEY=CHANGE_ME
FIN_API_SECRET=CHANGE_ME
FIN_API_PASSPHRASE=CHANGE_ME

# Polygon RPC (redemption fallback only).  Use a paid provider.
FIN_POLYGON_RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/CHANGE_ME

# Polymarket relayer (gasless redeem fallback).
FIN_RELAYER_API_KEY=CHANGE_ME
FIN_RELAYER_API_KEY_ADDRESS=0xCHANGE_ME
